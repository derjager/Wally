[Unit]
Description=Wally - captura de cámara
After=network.target
# No depende de wally-web: cada uno arranca y reinicia por su cuenta, y el
# buffer de frames en /dev/shm sobrevive al reinicio de cualquiera de los dos.

[Service]
Type=simple
User=wally
WorkingDirectory=/opt/wally
ExecStart=/opt/wally/.venv/bin/python -m services.vision
Restart=always
RestartSec=3

# Aquí corre la inferencia TFLite, que es lo que más CPU consume del sistema.
# Prioridad por debajo de motion: si la Pi se satura, es preferible perder
# fotogramas de detección antes que precisión en el lazo de control.
Nice=5

[Install]
WantedBy=multi-user.target
